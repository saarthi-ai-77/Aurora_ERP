# =========================
# APP
# =========================
NODE_ENV=development
PORT=4000

# =========================
# DATABASE (SUPABASE)
# =========================
DATABASE_URL=
DIRECT_URL=

# =========================
# JWT
# =========================
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =========================
# FRONTEND
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# REDIS
# =========================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# STORAGE
# =========================
STORAGE_PROVIDER=local

# =========================
# LOCAL STORAGE
# =========================
UPLOAD_DIR=uploads
